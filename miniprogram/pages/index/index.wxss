.page {
  min-height: 100vh;
  background: #ffffff;
  position: relative;
  transform: scale(1);
  transform-origin: top center;
  transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1), border-radius 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  border-radius: 0;
  overflow: hidden;
}

.page-dimmed {
  transform: scale(0.93);
  border-radius: 20rpx;
}


.header-wrap {
  background: #ffffff;
  border-radius: 50rpx;
  margin: 16rpx 16rpx 0;
}

.header {
  padding: 24rpx 36rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 1rpx;
}

.header-sub {
  font-size: 24rpx;
  color: #aaa;
}

.header-subscribe-btn {
  background: #f0f5ff;
  border: 2rpx solid #d0e4ff;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  color: #4A90E2;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-subscribe-icon { font-size: 26rpx; }

.card-list {
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  width: 100%;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 20rpx;
}

.empty-icon { font-size: 100rpx; opacity: 0.4; }
.empty-text { font-size: 34rpx; color: #444; font-weight: 700; }
.empty-hint { font-size: 26rpx; color: #aaa; }

.card {
  background: #ffffff;
  border-radius: 50rpx;
  padding: 32rpx 28rpx 32rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
  transition: box-shadow 0.6s ease, transform 0.5s cubic-bezier(0.32,0.72,0,1);
}

.card-expired  { box-shadow: -4px 0 12px rgba(255, 77, 79, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }
.card-today    { box-shadow: -4px 0 12px rgba(255, 122, 0, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }
.card-urgent   { box-shadow: -4px 0 12px rgba(250, 140, 22, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }
.card-warning  { box-shadow: -4px 0 12px rgba(250, 204, 21, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }
.card-safe     { box-shadow: -4px 0 12px rgba(82, 196, 26, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }
.card-countup  { box-shadow: -4px 0 12px rgba(74, 144, 226, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08); }

.card-photo-wrap { flex-shrink: 0; }

.card-photo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.card-photo-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f0f2f8, #e8eaf0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.card-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
}

.card-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-bell {
  font-size: 24rpx;
  flex-shrink: 0;
}

.card-date { font-size: 24rpx; color: #aaa; }

.card-note {
  font-size: 24rpx;
  color: #bbb;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 110rpx;
  flex-shrink: 0;
}

.card-label { font-size: 22rpx; color: #aaa; margin-bottom: 4rpx; }

.card-days {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}

.card-expired .card-days  { color: #ff4d4f; }
.card-today .card-days    { color: #ff7a00; }
.card-urgent .card-days   { color: #fa8c16; }
.card-warning .card-days  { color: #d4a017; }
.card-safe .card-days     { color: #52c41a; }
.card-countup .card-days  { color: #4A90E2; }

.card-unit { font-size: 22rpx; color: #aaa; margin-top: 4rpx; }

.card-wrap {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 50rpx;
  background: transparent;
  overflow: visible;
}

.card-pushed {
  box-shadow: -4px 0 12px rgba(150, 150, 150, 0.35), 0 4rpx 24rpx rgba(0,0,0,0.08) !important;
}



.card-delete-btn-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  padding: 0 12rpx;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 48rpx;
  bottom: 140rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4A90E2, #357abd);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(74,144,226,0.5);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 72rpx;
  line-height: 1;
  margin-top: -6rpx;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.modal-mask::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  transition: opacity 0.9s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: -1;
}

.modal-mask-edit::before {
  background: linear-gradient(to top, rgba(10,10,30,0.55) 70%, rgba(10,10,30,0.4) 82%, rgba(10,10,30,0) 100%);
}

.modal-mask-confirm::before {
  background: linear-gradient(to top, rgba(10,10,30,0.55) 30%, rgba(10,10,30,0.4) 50%, rgba(10,10,30,0) 100%);
}

.modal-mask-subscribed::before {
  background: linear-gradient(to top, rgba(10,10,30,0.55) 30%, rgba(10,10,30,0.4) 50%, rgba(10,10,30,0) 100%);
}

.modal-mask-active::before {
  opacity: 1;
}

.modal-mask-confirm {
  z-index: 350;
}

.modal {
  background: #f8f9fd;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1),
              height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
  overflow: hidden;
}


.modal-scroll {
  width: 100%;
  max-height: 85vh;
  overflow: hidden;
}

.modal-inner {
  padding: 16rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.modal-active {
  transform: translateY(0);
}

.modal-drag-bar {
  width: 80rpx;
  height: 8rpx;
  background: #dde0ea;
  border-radius: 4rpx;
  margin: 0 auto 32rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a2e;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.modal-header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.modal-close-btn {
  background: #fff0f0;
}

.modal-confirm-btn {
  background: #f0f5ff;
}

.modal-header-btn-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.modal scroll-view {
  transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.modal-close-btn .modal-header-btn-icon {
  color: #ff4d4f;
}

.modal-confirm-btn .modal-header-btn-icon {
  color: #4A90E2;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.form-textarea {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  line-height: 1.7;
}

.form-picker {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow { color: #bbb; font-size: 28rpx; }

.datetime-row {
  display: flex;
  gap: 16rpx;
}

.datetime-row .form-picker { flex: 1; }


.name-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.emoji-input-wrap {
  width: 100rpx;
  height: 100rpx;
  position: relative;
  flex-shrink: 0;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.emoji-input {
  width: 100%;
  height: 100%;
  font-size: 64rpx;
  text-align: center;
}


.name-textarea {
  flex: 1;
  height: 100rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  padding: 26rpx 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  box-sizing: border-box;
}


.mode-group {
  display: flex;
  background: #eef0f6;
  border-radius: 20rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
  position: relative;
  z-index: 1;
  transition: color 0.25s ease;
}

.mode-active {
  background: linear-gradient(135deg, #4A90E2, #357abd);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(74,144,226,0.35);
}

.mode-slider {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  width: calc(50% - 6rpx);
  background: linear-gradient(135deg, #4A90E2, #357abd);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,144,226,0.35);
  transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 0;
}

.mode-slider-countdown {
  transform: translateX(0);
  left: 6rpx;
}

.mode-slider-countup {
  transform: translateX(100%);
  left: 6rpx;
}

.switch-row {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.switch-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.switch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.switch-desc {
  font-size: 24rpx;
  color: #aaa;
}

.countup-reminder-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.countup-value-input {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 16rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  text-align: center;
  box-sizing: border-box;
}

.countup-unit-picker {
  flex-shrink: 0;
}

.countup-unit-picker .picker-text,
.countup-time-picker .picker-text {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.countup-time-label {
  font-size: 28rpx;
  color: #666;
  margin-left: 16rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #e74c3c;
  margin-top: 12rpx;
}

.reminder-preview {
  background: #f0f5ff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.reminder-preview-icon { font-size: 32rpx; }

.reminder-preview-text {
  font-size: 28rpx;
  color: #4A90E2;
  font-weight: 500;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #4A90E2, #357abd);
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  height: 96rpx;
  line-height: 1;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(74,144,226,0.4);
  border: none;
  box-sizing: border-box;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-btn {
  width: 100%;
  background: #f0f2f8;
  color: #888;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 1;
  text-align: center;
  border: none;
  box-sizing: border-box;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.confirm-modal {
  padding: 32rpx 40rpx 80rpx;
  text-align: center;
}

.confirm-icon {
  font-size: 80rpx;
  margin: 16rpx 0 24rpx;
  display: block;
}

.confirm-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
  display: block;
  margin-bottom: 24rpx;
}

.confirm-desc {
  font-size: 28rpx;
  color: #888;
  line-height: 1.8;
  display: block;
  margin-bottom: 8rpx;
  white-space: pre-wrap;
}

.undo-bar {
  position: fixed;
  bottom: 60rpx;
  left: 40rpx;
  right: 40rpx;
  background: rgba(220, 80, 80, 0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 50rpx;
  padding: 20rpx 20rpx 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 300;
  opacity: 0;
  transform: translateY(40rpx);
  transition: opacity 0.4s cubic-bezier(0.32, 0.72, 0, 1),
              transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}

.undo-bar-active {
  opacity: 1;
  transform: translateY(0);
}

.undo-bar-hiding {
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.undo-bar-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 8rpx;
  background: rgba(160, 0, 0, 0.85);
  transition: width 0.1s linear;
  z-index: 10;
  border-radius: 0 4rpx 4rpx 0;
}

.undo-countdown {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 700;
  margin-right: 16rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50rpx;
  padding: 8rpx 20rpx;
}

.undo-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.undo-btn {
  background: #4A90E2;
  border-radius: 50rpx;
  padding: 18rpx 44rpx;
  flex-shrink: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 20px rgba(74, 144, 226, 0.75), 0 0 12px rgba(74, 144, 226, 0.5);
}

.undo-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
}

.card-delete-btn-over {
  width: 260rpx;
  background: #e03030;
}


@keyframes flyOutLeft {
  from { transform: translateX(0); }
  to   { transform: translateX(-110%); }
}

.card-no-glow {
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08) !important;
}

.form-item.disabled {
  opacity: 0.5;
}

.form-item.disabled .switch-title {
  color: #999;
}

.form-item.disabled .switch-desc {
  color: #999;
}

.header-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-subscribed-btn {
  background: #d7d7ff94;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-subscribed-icon {
  font-size: 26rpx;
}

.header-subscribed-text {
  font-size: 24rpx;
}

.modal-subscribed {
  background: #f8f9fd;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 32rpx 80rpx;
  width: 100%;
  box-sizing: border-box;
  max-height: 80vh;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  will-change: transform;
  overflow: hidden;
}


.modal-subscribed.modal-active {
  transform: translateY(0);
}

.subscribed-scroll {
  max-height: 65vh;
  padding-bottom: 40rpx;
  overflow: hidden;
}

.subscribed-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.subscribed-empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.subscribed-empty-text {
  font-size: 28rpx;
  color: #aaa;
}

.subscribed-card-wrap {
  margin-bottom: 20rpx;
  box-shadow: none !important;
}

.subscribed-card-wrap .card {
  box-shadow: none !important;
  position: relative;
  z-index: 3;
}

.subscribed-card-wrap .card-expired,
.subscribed-card-wrap .card-today,
.subscribed-card-wrap .card-urgent,
.subscribed-card-wrap .card-warning,
.subscribed-card-wrap .card-safe,
.subscribed-card-wrap .card-countup,
.subscribed-card-wrap .card-pushed {
  box-shadow: none !important;
}


.subscribed-card-wrap:last-child {
  margin-bottom: 0;
}

.card-pushed-tag {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

.card-pushed .card-days {
  color: #999 !important;
}

.modal-header-placeholder {
  width: 72rpx;
}

.modal-mask-edit {
  z-index: 300;
}

.subscribed-card-delete-bg {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  right: 0;
  background: #ff4d4f;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 40rpx;
  z-index: 2;
  opacity: 0;
}

.subscribed-card-delete-bg.subscribed-bg-visible {
  opacity: 1;
}

.subscribed-card-delete-icon {
  font-size: 56rpx;
}

.subscribed-bg-flyout {
  animation: flyOutRight 0.4s cubic-bezier(0.32, 0.72, 0, 1) forwards;
}

.subscribed-card-wrap::after {
  content: '🗑';
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 56rpx;
  opacity: 0;
  transition: opacity 0.2s ease;
  z-index: 1;
}

.subscribed-card-wrap.show-delete::after {
  opacity: 1;
}

.switch-row + .form-item,
.form-item + .form-item {
  transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.3s ease;
}

.modal-clear-btn {
  background: #fff0f0;
}

.clear-bar {
  background: rgba(80, 80, 80, 0.55);
  justify-content: center;
  border-radius: 50rpx;
  padding: 38rpx 28rpx;
}


.card-complete-btn-full {
  border-radius: 50rpx;
  transition: width 0.3s cubic-bezier(0.32, 0.72, 0, 1), border-radius 0.3s ease;
}


.card-wrap-completing .card {
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1) !important;
}


.card-complete-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.card-delete-bg {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 240rpx;
  background: #ff4d4f;
  border-radius: 0 50rpx 50rpx 0;
  z-index: 0;
}


.card-wrap-flyout-left {
  animation: flyOutLeft 0.5s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  max-height: 200rpx;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              margin-bottom 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  margin-bottom: 20rpx;
}

/* 向右滑时，直接隐藏删除按钮 */
.card-wrap-swiping-right .card-delete-btn {
  display: none;
}
.card-wrap-swiping-left .card-complete-btn {
  display: none;
}

/* 向左滑时，删除按钮在上 */
.card-wrap-swiping-left .card-complete-btn {
  z-index: 0;
}
.card-wrap-swiping-left .card-delete-btn {
  z-index: 1;
}

.card-complete-icon {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}


.card-wrap:not(.subscribed-card-wrap) .card {
  margin-bottom: 0;
  position: relative;
  z-index: 2;
  border-radius: 50rpx;
  overflow: hidden;
}

@keyframes flyOutRight {
  from { transform: translateX(0); }
  to   { transform: translateX(110%); }
}


.card-wrap-flyout-collapse {
  max-height: 0 !important;
  margin-bottom: 0 !important;
}

.card-wrap-flyout {
  animation: flyOutLeft 0.5s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  max-height: 200rpx;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              margin-bottom 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  margin-bottom: 20rpx;
}

.card-wrap-flyout-complete {
  animation: flyOutRight 0.5s cubic-bezier(0.32, 0.72, 0, 1) forwards;
  max-height: 200rpx;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
              margin-bottom 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  margin-bottom: 20rpx;
}

.card-bg-btn {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  border-radius: 50rpx;
  z-index: 0;
}

.card-bg-delete {
  background: #ff4d4f;
  justify-content: flex-end;
  padding-right: 48rpx;
}

.card-bg-complete {
  background: rgba(74, 144, 226, 0.65);
  justify-content: flex-start;
  padding-left: 48rpx;
}

.card-bg-btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* ===== 排序按钮（顶部标题栏）===== */
.header-sort-icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f0f5ff;
  border: 2rpx solid #d0e4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-sort-icon {
  font-size: 34rpx;
  color: #4A90E2;
  line-height: 1;
}

/* ===== 排序弹窗 ===== */
.modal-mask-sort::before {
  background: linear-gradient(to top, rgba(10,10,30,0.55) 30%, rgba(10,10,30,0.4) 50%, rgba(10,10,30,0) 100%);
}
.sort-modal {
  padding: 24rpx 16rpx 60rpx;
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
}

.sort-modal-title {
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
  position: static;
  transform: none;
}
.sort-option {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  margin: 4rpx 16rpx;
  transition: background 0.2s;
}
.sort-option-active {
  background: rgba(74, 144, 226, 0.1);
}
.sort-option-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.sort-option-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sort-option-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.sort-option-desc {
  font-size: 24rpx;
  color: #aaa;
}
.sort-option-check {
  font-size: 32rpx;
  color: #4A90E2;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ===== 排序撤回横幅 ===== */
.sort-undo-bar {
  background: rgba(74, 100, 180, 0.55);  /* 蓝紫色，与删除红色区分 */
}
.sort-undo-bar-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 8rpx;
  background: rgba(30, 60, 160, 0.85);
  transition: width 0.1s linear;
  z-index: 10;
  border-radius: 0 4rpx 4rpx 0;
}

/* 横幅关闭按钮 */
.undo-close-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
  flex-shrink: 0;
  opacity: 0.7;
}
.undo-close-icon {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

/* 横幅被顶起时向上偏移（一个横幅高度约 100rpx + 间距 16rpx）*/
.undo-bar-stacked {
  transform: translateY(-116rpx) !important;
  transition: opacity 0.4s cubic-bezier(0.32, 0.72, 0, 1),
              transform 0.4s cubic-bezier(0.32, 0.72, 0, 1) !important;
}

.modal-subscribe-all-btn {
  background: #f0f5ff;
  width: auto;
  padding: 0 20rpx;
  gap: 8rpx;
}

.modal-subscribe-all-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: 600;
  white-space: nowrap;
}

.modal-subscribe-all-btn .modal-header-btn-icon {
  font-size: 32rpx;
}
