{
  "appid": "",
  "projectname": "timer-checklist",
  "compileType": "miniprogram",
  "libVersion": "3.14.2",
  "setting": {
    "coverView": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "preloadBackgroundData": false,
    "minified": true,
    "autoAudits": false,
    "newFeature": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "useIsolateContext": true,
    "nodeModules": false,
    "isProtectedCode": false,
    "bundle": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "miniprogram_npm" },
      { "type": "regexp", "value": "\\.md$" }
    ]
  },
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/"
}
